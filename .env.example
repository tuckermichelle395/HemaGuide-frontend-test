# Local default: Ollama must be running on the same host.
LLM_MODE=ollama-local
LLM_MODEL=qwen3:8b
DECISION_MODEL=qwen3:8b
EMBEDDING_MODE=ollama
EMBEDDING_MODEL=embeddinggemma:300m

# NCBI Entrez requires an email for PubMed requests.
PUBMED_EMAIL=your.email@example.com

# Optional API credentials.
NCBI_API_KEY=
CROSSREF_EMAIL=
OLLAMA_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
